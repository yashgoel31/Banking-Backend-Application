# ==========================================================================================
# BankSphere production configuration (docker compose)
#   cp .env.example .env   and replace EVERY CHANGE_ME. Never commit the real .env.
#   Anything still containing CHANGE_ME is refused: the services won't start in production, and the
#   Postgres/Redis/Kafka bootstrap scripts won't create users with such a password.
# Generate each password/secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (hex keeps passwords safe inside connection URLs). For local development run
#   node scripts/setup-dev-env.mjs   which fills all of this in with random values.
# ==========================================================================================

# --- PostgreSQL ----------------------------------------------------------------------------
# Superuser: only used by docker/postgres/init-schemas.sh on first start
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=banksphere
# Per service: OWNER runs migrations (DDL), APP is the runtime role (row DML only)
AUTH_DB_OWNER_PASSWORD=CHANGE_ME
AUTH_DB_APP_PASSWORD=CHANGE_ME
CUSTOMER_DB_OWNER_PASSWORD=CHANGE_ME
CUSTOMER_DB_APP_PASSWORD=CHANGE_ME
ACCOUNT_DB_OWNER_PASSWORD=CHANGE_ME
ACCOUNT_DB_APP_PASSWORD=CHANGE_ME
LEDGER_DB_OWNER_PASSWORD=CHANGE_ME
LEDGER_DB_APP_PASSWORD=CHANGE_ME
NOTIFICATION_DB_OWNER_PASSWORD=CHANGE_ME
NOTIFICATION_DB_APP_PASSWORD=CHANGE_ME
FRAUD_DB_OWNER_PASSWORD=CHANGE_ME
FRAUD_DB_APP_PASSWORD=CHANGE_ME

# --- Redis ---------------------------------------------------------------------------------
# Security store (token versions, revoked tokens, MFA challenges): one ACL user per role
REDIS_AUTH_PASSWORD=CHANGE_ME
REDIS_CUSTOMER_PASSWORD=CHANGE_ME
REDIS_READER_PASSWORD=CHANGE_ME
# Rate-limit counters (separate, evictable instance)
RATE_LIMIT_REDIS_PASSWORD=CHANGE_ME

# --- Kafka (SASL/SCRAM, one user per service) -----------------------------------------------
KAFKA_ADMIN_PASSWORD=CHANGE_ME
KAFKA_AUTH_PASSWORD=CHANGE_ME
KAFKA_ACCOUNT_PASSWORD=CHANGE_ME
KAFKA_LEDGER_PASSWORD=CHANGE_ME
KAFKA_FRAUD_PASSWORD=CHANGE_ME
KAFKA_NOTIFICATION_PASSWORD=CHANGE_ME

# --- Tokens --------------------------------------------------------------------------------
# ES256 key pair, generate with (after npm run build):
#   node -e "console.log(require('./packages/common/dist').generateJwtKeyPair())"
# JWT_SIGNING_KEY: base64 of the PKCS#8 PEM private key (auth-service only).
# JWT_VERIFY_KEYS: comma-separated kid:base64(SPKI PEM) public keys; keep the old key here while rotating.
JWT_SIGNING_KEY=CHANGE_ME
JWT_SIGNING_KEY_ID=CHANGE_ME
JWT_VERIFY_KEYS=CHANGE_ME
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=7
# AES-256-GCM key for TOTP secrets: 64 hex characters
MFA_ENCRYPTION_KEY=CHANGE_ME
# Service-to-service bearer tokens (>= 32 random characters each)
LEDGER_INTERNAL_TOKEN=CHANGE_ME
CUSTOMER_INTERNAL_TOKEN=CHANGE_ME

# --- Web / network -------------------------------------------------------------------------
# Frontend base URL used in email links (/verify-email#token=..., /reset-password#token=..., /staff/activate#token=...)
APP_BASE_URL=https://app.example.com
# Browser origins allowed by the API gateway (comma-separated)
CORS_ORIGINS=https://app.example.com
# Number of proxies in front of the gateway that OVERWRITE X-Forwarded-For (0 = clients connect directly).
# Required. Too high lets clients spoof their IP; too low makes every client look like the load balancer.
GATEWAY_TRUST_PROXY=CHANGE_ME
GATEWAY_PORT=8000
GATEWAY_RATE_LIMIT_PER_MINUTE=300
# Networks (VPN/office CIDRs, comma-separated) staff may sign in and work from. Required. Enforced by role in
# every service (staff tokens are refused from anywhere else, on every route) and by path at the gateway.
STAFF_ALLOWED_CIDRS=CHANGE_ME
# Staff accounts may only be created for this email domain
STAFF_EMAIL_DOMAIN=example.com

# --- Email (SMTP). Port 587 + STARTTLS (required) or 465 with SMTP_SECURE=true ---------------
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
MAIL_FROM="BankSphere <no-reply@example.com>"
SECURITY_ALERT_EMAIL=security-team@example.com

LOG_LEVEL=info
