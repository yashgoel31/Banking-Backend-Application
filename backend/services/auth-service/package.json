{
  "name": "@banksphere/auth-service",
  "version": "1.0.0",
  "description": "BankSphere Authentication Service - Identity, Argon2id, and JWT Rotation",
  "main": "dist/app.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "jest --runInBand",
    "create-admin": "node dist/scripts/create-admin.js",
    "prisma:deploy": "node ../../scripts/migrate.mjs",
    "pretest": "prisma generate"
  },
  "dependencies": {
    "@banksphere/common": "*",
    "@prisma/client": "^5.14.0",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.8",
    "express": "^4.19.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "prisma": "^5.14.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
