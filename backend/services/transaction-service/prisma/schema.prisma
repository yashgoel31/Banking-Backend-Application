datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  CASH_TRANSFER // internal cash movement: vault <-> drawer floats, count differences to suspense
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum EntryType {
  DEBIT
  CREDIT
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum LedgerAccountKind {
  CUSTOMER      // customer deposit account (a liability of the bank)
  TELLER_CASH   // a teller's cash drawer (an asset): every cash deposit/withdrawal is double-entry against it
  VAULT_CASH    // the branch vault (an asset): issues floats to drawers and receives them back
  CASH_SUSPENSE // counted shortages (debit) / overages (credit) awaiting investigation
}

// Authoritative local account representation within the ledger service boundary
model LedgerAccount {
  id            String         @id @default(uuid())
  kind          LedgerAccountKind @default(CUSTOMER)
  accountNumber String         @unique @map("account_number")
  customerId    String         @map("customer_id")
  currency      String         @default("INR")
  balance       BigInt         @default(0) // Stored in minor units (e.g. Paise: 10000 = ₹100.00)
  dailyLimit    BigInt         @default(10000000) @map("daily_limit") // Max outgoing paise per IST calendar day
  isActive      Boolean        @default(true) @map("is_active")
  // Set once, by the ledger itself, only when the balance is zero; a closed account can never reopen
  closedAt      DateTime?      @map("closed_at")
  // Monotonic version of the control state (active/limit/closed) pushed by account-service; older writes are refused
  controlVersion Int           @default(0) @map("control_version")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  entries       LedgerEntry[]

  @@index([customerId])
  @@map("ledger_accounts")
}

// Financial transactions metadata
model Transaction {
  id                    String            @id @default(uuid())
  referenceId           String            @unique @map("reference_id") // Business reference (e.g., TXN-2026-XXXX)
  type                  TransactionType
  status                TransactionStatus @default(PENDING)
  amount                BigInt            // Amount in minor units (paise)
  currency              String            @default("INR")
  sourceAccountId       String?           @map("source_account_id")
  destinationAccountId  String?           @map("destination_account_id")
  description           String?
  initiatedBy           String?           @map("initiated_by") // User ID that requested the movement (audit)
  failureReason         String?           @map("failure_reason")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  entries               LedgerEntry[]

  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@index([createdAt])
  @@map("transactions")
}

// Immutable, append-only double-entry ledger entries
model LedgerEntry {
  id            String         @id @default(uuid())
  transactionId String         @map("transaction_id")
  accountId     String         @map("account_id")
  entryType     EntryType      @map("entry_type")
  amount        BigInt         // Positive minor units (paise)
  currency      String         @default("INR")
  balanceAfter  BigInt         @map("balance_after") // Running balance snapshot
  createdAt     DateTime       @default(now()) @map("created_at")

  transaction   Transaction    @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account       LedgerAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt, id])
  @@index([transactionId])
  @@map("ledger_entries")
}

// Idempotency records for financial write safety
model IdempotencyRecord {
  id             String            @id @default(uuid())
  userId         String            @map("user_id") // Keys are scoped per caller so users can't collide with or replay each other
  key            String
  endpoint       String
  requestHash    String            @map("request_hash")
  status         IdempotencyStatus @default(PROCESSING)
  statusCode     Int?              @map("status_code")
  responseBody   Json?             @map("response_body")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  expiresAt      DateTime          @map("expires_at")

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// Transactional Outbox for reliable Kafka event publishing
model OutboxEvent {
  id            String        @id @default(uuid())
  seq           BigInt       @default(autoincrement()) // per-aggregate publish order
  aggregateType String        @map("aggregate_type") // e.g. "TRANSACTION"
  aggregateId   String        @map("aggregate_id")   // e.g. transaction.id
  eventType     String        @map("event_type")     // e.g. "transaction.completed.v1"
  payload       Json
  status        OutboxStatus  @default(PENDING)
  retryCount    Int           @default(0) @map("retry_count")
  lastError     String?       @map("last_error")
  nextAttemptAt DateTime?     @map("next_attempt_at")
  lockedUntil   DateTime?    @map("locked_until") // relay lease: a crashed relay's claim expires
  lockedBy      String?      @map("locked_by") // fencing token of the relay holding the lease
  createdAt     DateTime      @default(now()) @map("created_at")
  publishedAt   DateTime?     @map("published_at")

  @@index([status, nextAttemptAt, createdAt])
  @@index([aggregateId, status, seq])
  @@unique([seq])
  @@map("outbox_events")
}

enum CashOperationType {
  DEPOSIT
  WITHDRAWAL
}

enum CashOperationStatus {
  PENDING_APPROVAL
  EXECUTED
  REJECTED
}

// Teller cash movements. Large amounts (or a teller exceeding their daily total) need a second
// BANK_ADMIN to approve (maker-checker); every operation is kept here for audit and per-teller caps.
model CashOperation {
  id            String              @id @default(uuid())
  type          CashOperationType
  status        CashOperationStatus
  accountId     String              @map("account_id")
  amount        BigInt
  description   String?
  requestedBy   String              @map("requested_by")
  approvedBy    String?             @map("approved_by")
  decidedAt     DateTime?           @map("decided_at")
  transactionId String?             @unique @map("transaction_id")
  createdAt     DateTime            @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([requestedBy, createdAt])
  @@map("cash_operations")
}

// Append-only audit trail of staff actions on the ledger (UPDATE/DELETE blocked by trigger)
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String   @map("actor_id")
  action    String
  targetId  String?  @map("target_id")
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@map("audit_log")
}

enum TellerSessionStatus {
  ISSUED      // a supervisor issued the opening float; awaiting the teller's count
  OPEN        // the teller counted and accepted the float; it is booked vault -> drawer
  CLOSED      // the teller declared a blind closing count; awaiting the supervisor's blind count
  RECONCILED  // both counts matched; cash returned to the vault, any difference posted to suspense
  CANCELLED   // an issued float that was never accepted
}

// A teller's business day: opening float -> cash operations -> closing count -> supervisor sign-off.
// Expected closing cash = opening float + net drawer movement; any discrepancy is flagged.
model TellerSession {
  id              String              @id @default(uuid())
  tellerId        String              @map("teller_id")
  businessDate    String              @map("business_date") // IST calendar date, YYYY-MM-DD
  drawerAccountId String              @map("drawer_account_id")
  openingFloat    BigInt              @map("opening_float")
  issuedBy        String?             @map("issued_by")
  status          TellerSessionStatus @default(ISSUED)
  declaredClosing BigInt?             @map("declared_closing")
  expectedClosing BigInt?             @map("expected_closing")
  discrepancy     BigInt?
  openedAt        DateTime            @default(now()) @map("opened_at") // issue time; acceptedAt is when cash duty began
  acceptedAt      DateTime?           @map("accepted_at")
  closedAt        DateTime?           @map("closed_at")
  signedOffBy     String?             @map("signed_off_by")
  signedOffAt     DateTime?           @map("signed_off_at")

  @@unique([tellerId, businessDate])
  @@index([status, businessDate])
  @@map("teller_sessions")
}

// A customer-generated, single-use authorisation for a cash withdrawal at a branch: the teller must enter
// the code, so a teller can never withdraw from an account without the customer's consent.
model WithdrawalAuthorization {
  id              String    @id @default(uuid())
  accountId       String    @map("account_id")
  customerId      String    @map("customer_id")
  amount          BigInt
  codeHash        String    @map("code_hash")
  expiresAt       DateTime  @map("expires_at")
  usedAt          DateTime? @map("used_at")
  cashOperationId String?   @map("cash_operation_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([accountId, usedAt])
  @@map("withdrawal_authorizations")
}

// Registered payees. Transfers to other customers' accounts require an active beneficiary: new ones
// activate after a cooling-off period (immediately with an MFA session) and are capped for 24h.
model Beneficiary {
  id            String    @id @default(uuid())
  customerId    String    @map("customer_id")
  accountId     String    @map("account_id")
  accountNumber String    @map("account_number")
  nickname      String
  activatesAt   DateTime  @map("activates_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([customerId, accountId])
  @@index([customerId])
  @@map("beneficiaries")
}

// Leader election for periodic jobs across replicas (see acquireJobLease in @banksphere/common)
model JobLease {
  name      String   @id
  holder    String
  expiresAt DateTime @map("expires_at")

  @@map("job_leases")
}
