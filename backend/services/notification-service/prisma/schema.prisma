datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  SENT
  FAILED
  DEAD_LETTER
}

// Consumer idempotency guard: guarantees duplicate Kafka events are never processed twice
model ProcessedEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique @map("event_id") // Business event UUID from Kafka
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([eventId])
  @@map("processed_events")
}

// Audit trail of all customer notifications
model NotificationLog {
  id           String              @id @default(uuid())
  recipient    String              // Email address or phone number
  channel      NotificationChannel @default(EMAIL)
  subject      String
  body         String
  status       NotificationStatus  @default(SENT)
  retryCount   Int                 @default(0) @map("retry_count")
  lastError    String?             @map("last_error")
  metadata     Json?
  createdAt    DateTime            @default(now()) @map("created_at")

  @@index([recipient])
  @@index([status])
  @@map("notification_logs")
}

// Local read model built from user.registered.v1: lets the service resolve a user's email
// without a synchronous call to the auth service
model UserContact {
  userId    String   @id @map("user_id")
  email     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_contacts")
}

// Local read model built from account.created.v1: maps ledger account IDs to their owner
model AccountOwner {
  accountId     String   @id @map("account_id")
  customerId    String   @map("customer_id")
  accountNumber String   @map("account_number")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([customerId])
  @@map("account_owners")
}

// One row per email: claimed BEFORE it is sent (released again only after a transient SMTP failure), so
// retries, redeliveries and concurrent consumers never send the same email twice
model NotificationDelivery {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id") // event id, or "<eventId>:<purpose>" (e.g. :debit / :credit) when one event sends several emails to one address
  recipient String
  sentAt    DateTime @default(now()) @map("sent_at")

  @@unique([eventId, recipient])
  @@map("notification_deliveries")
}
