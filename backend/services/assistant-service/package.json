{
  "name": "@banksphere/assistant-service",
  "version": "1.0.0",
  "description": "BankSphere Sphere assistant - read-only banking assistant over SSE",
  "main": "dist/app.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "prisma:deploy": "node ../../scripts/migrate.mjs",
    "pretest": "prisma generate",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@banksphere/common": "*",
    "@prisma/client": "^5.14.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^26.6.5",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^5.14.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
