datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

enum AccountType {
  SAVINGS
  CURRENT
}

enum AccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

model BankAccount {
  id               String        @id @default(uuid())
  accountNumber    String        @unique @map("account_number")
  customerId       String        @map("customer_id")
  accountType      AccountType   @default(SAVINGS) @map("account_type")
  status           AccountStatus @default(ACTIVE)
  currency         String        @default("INR")
  dailyLimit       BigInt        @default(10000000) @map("daily_limit") // In paise: default ₹1,00,000.00
  // Last daily limit set by a bank administrator: the owner may lower freely but raise only up to this (and the customer cap)
  bankLimitCeiling BigInt?       @map("bank_limit_ceiling")
  // Version of the control state (status, limit) pushed to the ledger; bumped on every change
  version          Int           @default(1)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([accountNumber])
  @@map("bank_accounts")
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

// Transactional outbox: account events are written atomically with the account change
model OutboxEvent {
  id            String       @id @default(uuid())
  seq           BigInt       @default(autoincrement()) // per-aggregate publish order
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  eventType     String       @map("event_type")
  payload       Json
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0) @map("retry_count")
  lastError     String?      @map("last_error")
  nextAttemptAt DateTime?    @map("next_attempt_at")
  lockedUntil   DateTime?    @map("locked_until") // relay lease: a crashed relay's claim expires
  lockedBy      String?      @map("locked_by") // fencing token of the relay holding the lease
  createdAt     DateTime     @default(now()) @map("created_at")
  publishedAt   DateTime?    @map("published_at")

  @@index([status, nextAttemptAt, createdAt])
  @@index([aggregateId, status, seq])
  @@unique([seq])
  @@map("outbox_events")
}

// Append-only audit trail of status / limit changes (UPDATE/DELETE blocked by trigger)
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String   @map("actor_id")
  action    String
  targetId  String   @map("target_id")
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([targetId, createdAt])
  @@map("audit_log")
}

// Who on staff looked at which customer's accounts, and when (append-only)
model StaffAccessLog {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  actorRole  String   @map("actor_role")
  customerId String   @map("customer_id")
  accountId  String?  @map("account_id")
  action     String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([customerId, createdAt])
  @@index([actorId, createdAt])
  @@map("account_staff_access_log")
}

// Leader election for periodic jobs across replicas (see acquireJobLease in @banksphere/common)
model JobLease {
  name      String   @id
  holder    String
  expiresAt DateTime @map("expires_at")

  @@map("job_leases")
}
