{
  "name": "@banksphere/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BankSphere web app: customer internet banking and the staff back office",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
