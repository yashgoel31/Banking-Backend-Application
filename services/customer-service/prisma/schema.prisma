datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

model CustomerProfile {
  id          String    @id @default(uuid())
  userId      String    @unique @map("user_id") // References Auth User ID without cross-db FK
  fullName    String    @map("full_name")
  phoneNumber String    @map("phone_number")
  address     String?
  dateOfBirth DateTime? @map("date_of_birth")
  kycStatus   KycStatus @default(PENDING) @map("kyc_status")
  // Incremented on every change; a KYC decision must name the version the officer reviewed
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([phoneNumber])
  @@map("customer_profiles")
}

// Append-only KYC audit trail: who approved/rejected whom, and identity changes that reset KYC
model KycEvent {
  id         String     @id @default(uuid())
  userId     String     @map("user_id")
  actorId    String     @map("actor_id")
  action     String
  fromStatus KycStatus? @map("from_status")
  toStatus   KycStatus? @map("to_status")
  details    Json?
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("kyc_events")
}

// Who on staff looked at which customer's data, and when (append-only)
model StaffAccessLog {
  id        String   @id @default(uuid())
  actorId   String   @map("actor_id")
  actorRole String   @map("actor_role")
  userId    String   @map("user_id")
  action    String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([actorId, createdAt])
  @@map("staff_access_log")
}
